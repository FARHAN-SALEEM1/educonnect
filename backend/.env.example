# ─────────────────────────────────────────────────────────────
# EduConnect Backend — Environment Configuration
# Copy this file to `.env` and fill in your own values.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5001

# PostgreSQL connection string.
# Local:  postgresql://USER:PASSWORD@localhost:5432/DBNAME?schema=public
# Neon / Supabase / Railway: paste the connection string they give you.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/educonnect_v2?schema=public"

# JWT secrets — CHANGE THESE. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars_long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Password hashing cost factor
BCRYPT_ROUNDS=10

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate limiting (requests per window)
# A whole school reaches the API from one public address, so the per-IP
# budgets are generous and the per-identity ones are tight. The auth limits
# count FAILURES only — successful sign-ins never consume them.
RATE_LIMIT_WINDOW_MINUTES=15
# All API requests, per IP. A single page view is roughly eight calls.
RATE_LIMIT_MAX=2000
# Failed sign-in attempts, per IP (shared by everyone at that school).
AUTH_RATE_LIMIT_MAX=50
# Failed attempts against one email address, from anywhere. This is the limit
# that actually blunts credential stuffing; keep it tight.
ACCOUNT_RATE_LIMIT_MAX=10
# Rejected session refreshes, per IP.
REFRESH_RATE_LIMIT_MAX=60
# Wrong current-password attempts, per signed-in user.
PASSWORD_CHANGE_RATE_LIMIT_MAX=10

# Fallback only. Accounts created without an explicit password now get a
# random one that is emailed to the user, so this is rarely used.
# The server refuses to start in production if this is left as-is.

# ─────────────────────────────────────────────────────────────
# Email — optional in development, REQUIRED in production
#
# Leave SMTP_HOST blank locally and emails are printed to the console instead
# of being sent, so nothing breaks without a mail server.
#
# In production the server REFUSES TO START without SMTP_HOST and SMTP_FROM.
# Without them a password-reset link would only ever reach the server log:
# nobody could reset a password, and live reset tokens would sit in log
# aggregation for anyone with log access to use.
#
# Gmail: smtp.gmail.com:587 with an App Password (not your account password).
# Resend: smtp.resend.com:587, user "resend", pass = your API key.
#
# SMTP_PASS is a credential — set it in your host's secret store, never in a
# committed file.
# ─────────────────────────────────────────────────────────────
# Public base URL of the frontend. Every emailed link is built from this:
# password reset, billing returns, and the login link in each welcome mail.
# Production REFUSES TO START if this is missing, points at localhost, or is
# plaintext http:// — a reset token in a clear link is a password change in
# the open, and a localhost link resolves to whoever opened the mail.
APP_URL=http://localhost:5173

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EduConnect <no-reply@educonnect.io>"

# TLS. Port 465 is encrypted from the first byte; 587 and 25 start in plain
# text and upgrade with STARTTLS.
#
# Leave this blank and STARTTLS is REQUIRED whenever SMTP_USER is set, which
# is what you want: without it the upgrade is optional, and a relay that does
# not offer STARTTLS receives your password in the clear while the send still
# reports success. Set it to false only for a relay on a trusted network that
# genuinely cannot do TLS.
SMTP_REQUIRE_TLS=

# Where password-reset links point — your frontend's public URL.
# Also where the payment provider returns the browser after checkout.
APP_URL=http://localhost:5173
PASSWORD_RESET_EXPIRY_MINUTES=30

# ─────────────────────────────────────────────────────────────
# Payments
#
# `manual` means subscriptions are settled by bank transfer and recorded by a
# super admin. It is the default and needs no configuration.
#
# Choosing a gateway makes its secrets REQUIRED: production refuses to start
# without them, because checkout that works while confirmations cannot be
# verified would take money and grant nothing.
#
# NOTE: Stripe does not operate in Pakistan. The Stripe adapter is written but
# UNVERIFIED — it has never run against real Stripe traffic. A Pakistan-capable
# provider (Safepay, PayFast, JazzCash) plugs into the same interface without a
# schema change.
# ─────────────────────────────────────────────────────────────
PAYMENT_PROVIDER=manual

# Safepay (getsafepay.pk) — the chosen Pakistani gateway, PKR native.
# Only read when PAYMENT_PROVIDER=safepay. Keep both in your secret store.
#
# SAFEPAY_ENVIRONMENT is sandbox unless you say otherwise, deliberately: an
# install that forgets to set it must not reach live money. Switching it to
# `production` also requires SAFEPAY_VERIFIED=true, which is your acknowledgement
# that the sandbox checks in DEPLOYMENT.md have actually been run.
SAFEPAY_API_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_ENVIRONMENT=sandbox

# The dashboard's "Public key". A public identifier, not a credential — it is
# the `client` field on Safepay's order-init call, and it is NOT the same value
# as SAFEPAY_API_KEY. Sending the secret there answers "Client with this
# identifier not found", which is a confusing way to spend an afternoon.
# Only the sandbox verification script reads it.
SAFEPAY_PUBLIC_KEY=

# Sandbox diagnostic: append raw webhook deliveries to this file, before
# verification, so the exact signed bytes can be studied. Safepay's docs and
# their own SDK disagree about what the signature covers, and only a real
# delivery settles it.
#
# Verification is unaffected — unverified events are still rejected. But each
# captured line holds payer details and a valid signature, so PRODUCTION
# REFUSES TO START while this is set. Leave it blank unless you are actively
# debugging, and delete the file afterwards.
SAFEPAY_CAPTURE_WEBHOOKS=

# Only when PAYMENT_PROVIDER=stripe. Stripe does not operate in Pakistan.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────
# Refresh-token cookie
# Set COOKIE_CROSS_SITE=true only when the API and frontend are on
# DIFFERENT domains (e.g. Render + Vercel). It switches the cookie to
# SameSite=None, which browsers accept only over HTTPS.
# Leave false for same-origin or proxied setups — including local dev.
# ─────────────────────────────────────────────────────────────
COOKIE_CROSS_SITE=false
# COOKIE_DOMAIN=.yourschool.com   # only for sharing across subdomains

